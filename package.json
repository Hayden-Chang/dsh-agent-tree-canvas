{
  "name": "agent-tree-canvas-plugin-development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run packages/agent-tree-canvas/tests",
    "pack": "pnpm --dir packages/agent-tree-canvas pack --pack-destination ../../dist",
    "typecheck": "tsc -p tsconfig.tests.host.json && tsc -p tsconfig.tests.client.json",
    "test:web": "vitest run --config vitest.web.config.ts",
    "market:index": "node scripts/market-index.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "esbuild": "0.27.0",
    "lightningcss": "^1.30.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "vitest": "4.0.6",
    "jsdom": "^27.1.0",
    "playwright": "1.61.1",
    "zustand": "~4.5.7",
    "immer": "^10.1.1",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
